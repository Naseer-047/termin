{
  "name": "bro-photo",
  "version": "1.0.0",
  "description": "Convert a photograph into beautiful ASCII art in the terminal.",
  "main": "dist/index.js",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cli",
    "ascii",
    "terminal",
    "photo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
